# Google Apps Script Spreadsheet Database Configuration

# Spreadsheet ID (取得方法: スプレッドシートのURLから取得)
# URL例: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Sheet名 (データベースとして使用するシート名)
SHEET_NAME=Database

# アプリケーション設定
APP_NAME=GAS Spreadsheet Database App
APP_VERSION=1.0.0

# ログ設定
LOG_LEVEL=INFO
LOG_SHEET_NAME=Logs

# データベース設定
# 主キーとして使用するカラム名
PRIMARY_KEY_COLUMN=ID

# タイムスタンプカラム名
CREATED_AT_COLUMN=CreatedAt
UPDATED_AT_COLUMN=UpdatedAt

# その他の設定
TIMEZONE=Asia/Tokyo
DATE_FORMAT=yyyy-MM-dd HH:mm:ss
